# --- Uygulama ---
DATABASE_URL=sqlite:///./vdeploy.db
# PostgreSQL için: postgresql+psycopg://vdeploy:parola@dbhost:5432/vdeploy
APP_BASE_URL=http://vdeploy.vlifetr.local
TIMEZONE=Europe/Istanbul

# --- Bakım penceresi (bu aralık dışındaki prod deploy'lar "pencere dışı" sayılır) ---
MAINT_WINDOW_START=22:00
MAINT_WINDOW_END=06:00
MAINT_WEEKEND_ALLOWED=true

# --- Jira ---
# server = Data Center / Server (PAT ile), cloud = Jira Cloud (e-posta + API token)
JIRA_DEPLOYMENT=server
JIRA_BASE_URL=https://jira.vlifetr.local
JIRA_PAT=
JIRA_USER=
JIRA_API_TOKEN=
JIRA_JQL=project = CHG AND updated >= -8d ORDER BY created ASC
JIRA_MAPPING_FILE=config/jira_mapping.yaml
# true / false / kurum CA dosyasının yolu
JIRA_VERIFY_SSL=true

# --- Haftalık rapor (SMTP relay) ---
SMTP_HOST=smtp.vlifetr.local
SMTP_PORT=25
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
REPORT_FROM=vdeploy@vlifetr.local
REPORT_TO=ozgur@vlifetr.local

# --- Zamanlayıcı: her hafta bu gün/saatte önce Jira senkronu, sonra rapor ---
SCHEDULER_ENABLED=true
WEEKLY_JOB_DAY=mon
WEEKLY_JOB_TIME=08:00
